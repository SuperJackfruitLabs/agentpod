  "purpose": "The fingerprint digest is what an evaluation groups by, and three runtimes compute it: the hub (TypeScript), superwitness (Go) and the agent-skills offline runner. A digest that differs by one escaped character silently splits one configuration into two. These vectors make that a failing test in every one of them.",
  "rules": {
    "fields": ["harness", "harness_version", "model", "profile", "skill_release"],
    "canonical": "JSON object of exactly these five string fields, keys sorted, no whitespace, UTF-8, `<` `>` `&` and non-ASCII NOT escaped (JSON.stringify output).",
    "digest": "\"sha256:\" + lowercase hex of SHA-256 over the canonical bytes",
    "unknown": "A value that cannot be determined is the literal \"unknown\"; values are trimmed and an empty value becomes \"unknown\".",
    "notInDigest": "reported_by"
  },
