{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2023"], "module": "ESNext", "moduleResolution": "bundler",
    "strict": true, "declaration": true, "rootDir": ".", "noEmit": true,
    "verbatimModuleSyntax": true, "skipLibCheck": true
