# =============================================================================
# AgentPod Docker Compose Environment
# =============================================================================
# Copy this file to .env to configure docker-compose
#
# For local development, the defaults work out of the box.
# For production, change all security-related values.
# =============================================================================

# =============================================================================
# PostgreSQL Database
# =============================================================================
# Password for PostgreSQL (CHANGE IN PRODUCTION!)
POSTGRES_PASSWORD=agentpod-dev-password

# Full connection URL for Drizzle ORM
# Used by the API when running outside Docker (local development)
DATABASE_URL=postgres://agentpod:agentpod-dev-password@localhost:5432/agentpod

# =============================================================================
# Authentication (Better Auth)
# =============================================================================
# Session secret for cookie signing (CHANGE IN PRODUCTION!)
# Generate with: openssl rand -base64 32
SESSION_SECRET=dev-session-secret-change-in-production

# GitHub OAuth (optional - enables "Login with GitHub")
# Create at: https://github.com/settings/developers
# For local dev, callback URL: http://api.localhost/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# =============================================================================
# API Security
# =============================================================================
# API token for mobile app authentication (CHANGE IN PRODUCTION!)
# Generate with: openssl rand -base64 32
API_TOKEN=dev-token-change-in-production

# Encryption key for storing provider API keys (CHANGE IN PRODUCTION!)
# Must be exactly 32 characters. Generate with: openssl rand -base64 24
ENCRYPTION_KEY=dev-encrypt-key-exactly-32chars!

# =============================================================================
# Host Path Prefix (Required for Docker-in-Docker bind mounts)
# =============================================================================
# When the API runs inside Docker, sandbox containers need host paths for bind mounts.
# Set this to the absolute path of this project on your host machine.
# Example: /home/user/Projects/agentpod
HOST_PATH_PREFIX=

# =============================================================================
# Container Registry (Production Only)
# =============================================================================
# Leave empty for local development (uses locally built images)
OPENCODE_REGISTRY_URL=
OPENCODE_REGISTRY_OWNER=
OPENCODE_CONTAINER_VERSION=latest

# =============================================================================
# Cloudflare Sandbox Integration (Optional)
# =============================================================================
# Enable lightweight, on-demand sandboxes via Cloudflare Workers
# See: docs/ideas/cloudflare-sandbox-integration.md
ENABLE_CLOUDFLARE_SANDBOXES=false
CLOUDFLARE_WORKER_URL=
CLOUDFLARE_API_TOKEN=

# =============================================================================
# Observability Configuration
# =============================================================================
# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Grafana admin password (CHANGE IN PRODUCTION!)
# Access via SSH tunnel: ssh -L 3000:localhost:3000 user@your-vps
GRAFANA_PASSWORD=admin

# Telegram alerting (optional)
# 1. Create bot: Message @BotFather, send /newbot
# 2. Get chat ID: Message your bot, then visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# =============================================================================
# MetaMCP Configuration (MCP Server Aggregation)
# =============================================================================
# Authentication secret for MetaMCP (CHANGE IN PRODUCTION!)
# Generate with: openssl rand -base64 32
METAMCP_AUTH_SECRET=metamcp-dev-secret-change-in-prod

# MetaMCP URL (internal, for API communication)
METAMCP_URL=http://metamcp:12008

# Disable new user signup on MetaMCP after initial setup
METAMCP_DISABLE_SIGNUP=false

# =============================================================================
# Backup Configuration
# =============================================================================
# Backup retention (defaults shown)
# KEEP_DAILY=7    # Keep 7 daily backups
# KEEP_WEEKLY=4   # Keep 4 weekly backups

# =============================================================================
# kaambaan bridge (claim board work onto stations)
# =============================================================================
# OFF unless this is literally "true". Nothing is inferred from the presence of
# a token — a credential sitting in an env file is not a decision to start
# claiming work on someone's board.
# ENABLE_KAAMBAAN_BRIDGE=false

# Origin of the kaambaan deployment to claim from.
# KAAMBAAN_BASE_URL=https://kaambaan.dev

# One entry per agent identity. Each is a separate principal with its own
# `kbn_` token (minted in kaambaan under "Connect an agent"), its own board and
# its own station — the process is shared, the identity is not.
#
#   key          stable name; lands in bridge_dispatches.agent_key and in logs
#   hubUserId    the hub user the ACP session belongs to (sessions are
#                authorized by user id, so a background worker needs a real one)
#   mode         "full-auto" (default) or "accept-edits". "ask" is refused: a
#                permission request becomes a kaambaan elicitation and kaambaan
#                has no return path for one, so the card would park until the
#                15-minute reclaim with the harness blocked (spike RQ2).
#
# KAAMBAAN_BRIDGE_AGENTS=[{"key":"codex-mac","boardId":"brd_...","token":"kbn_...","stationId":"station_...","hubUserId":"...","mode":"full-auto"}]
