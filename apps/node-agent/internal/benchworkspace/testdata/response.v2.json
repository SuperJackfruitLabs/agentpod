{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/SuperJackfruitLabs/treaty/main/schemas/superbench/response.v2.json",
  "title": "Proposed SuperBench workspace operation responses v2",
  "description": "PROPOSED response contract. Does not establish acceptance, deployment or consumer conformance. All responses <=1 MiB; growth receipts <=64 KiB. Semantic checks bind HTTP/request identity, grant authority, complete ordered vectors, phases, privacy, safe integers and UTF8 byte limits. Requests and v1 bytes are unchanged.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "ok"],
  "properties": {
    "version": {
      "const": "superbench.v2"
    },
    "operation": {
      "enum": [
        "create",
        "recover",
        "lease",
        "run",
        "setup",
        "checkpoint",
        "release",
        "stop",
        "stop_admin",
        "archive",
        "status",
        "host_status"
      ]
    },
    "request_id": {
      "$ref": "#/$defs/key"
    },
    "ok": {
      "type": "boolean"
    },
    "result": {},
    "error": {
      "$ref": "#/$defs/error"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          }
        }
      },
      "then": {
        "not": {
          "required": ["error"]
        }
      }
    },
    {
      "if": {
        "required": ["operation"],
        "properties": {
          "operation": {
            "enum": ["create", "recover", "lease", "run", "setup"]
          }
        }
      },
      "then": {
        "required": ["request_id"]
      },
      "else": {
        "not": {
          "required": ["request_id"]
        }
      }
    }
  ],
  "oneOf": [
    {
      "required": ["operation", "ok", "result"],
      "properties": {
        "operation": {
          "enum": ["create", "recover", "lease"]
        },
        "request_id": {
          "$ref": "#/$defs/key"
        },
        "ok": {
          "const": true
        },
        "result": {
          "$ref": "#/$defs/mutation"
        }
      }
    },
    {
      "required": ["operation", "ok", "error"],
      "properties": {
        "operation": {
          "enum": ["create", "recover", "lease"]
        },
        "request_id": {
          "$ref": "#/$defs/key"
        },
        "ok": {
          "const": false
        },
        "result": {
          "$ref": "#/$defs/mutation"
        }
      }
    },
    {
      "required": ["operation", "ok", "result"],
      "properties": {
        "operation": {
          "enum": ["run"]
        },
        "request_id": {
          "$ref": "#/$defs/key"
        },
        "ok": {
          "const": true
        },
        "result": {
          "$ref": "#/$defs/run"
        }
      }
    },
    {
      "required": ["operation", "ok", "error"],
      "properties": {
        "operation": {
          "enum": ["run"]
        },
        "request_id": {
          "$ref": "#/$defs/key"
        },
        "ok": {
          "const": false
        },
        "result": {
          "$ref": "#/$defs/run"
        }
      }
    },
    {
      "required": ["operation", "ok", "result"],
      "properties": {
        "operation": {
          "enum": ["setup"]
        },
        "request_id": {
          "$ref": "#/$defs/key"
        },
        "ok": {
          "const": true
        },
        "result": {
          "$ref": "#/$defs/setup"
        }
      }
    },
    {
      "required": ["operation", "ok", "error"],
      "properties": {
        "operation": {
          "enum": ["setup"]
        },
        "request_id": {
          "$ref": "#/$defs/key"
        },
        "ok": {
          "const": false
        },
        "result": {
          "$ref": "#/$defs/setup"
        }
      }
    },
    {
      "required": ["operation", "ok", "result"],
      "properties": {
        "operation": {
          "enum": ["checkpoint", "release", "stop", "stop_admin", "archive"]
        },
        "ok": {
          "const": true
        },
        "result": {
          "$ref": "#/$defs/mutation"
        }
      }
    },
    {
      "required": ["operation", "ok", "error"],
      "properties": {
        "operation": {
          "enum": ["checkpoint", "release", "stop", "stop_admin", "archive"]
        },
        "ok": {
          "const": false
        },
        "result": {
          "$ref": "#/$defs/mutation"
        }
      }
    },
    {
      "required": ["operation", "ok", "result"],
      "properties": {
        "operation": {
          "enum": ["status"]
        },
        "ok": {
          "const": true
        },
        "result": {
          "$ref": "#/$defs/status"
        }
      }
    },
    {
      "required": ["operation", "ok", "error"],
      "properties": {
        "operation": {
          "enum": ["status"]
        },
        "ok": {
          "const": false
        },
        "result": {
          "$ref": "#/$defs/status"
        }
      }
    },
    {
      "required": ["operation", "ok", "result"],
      "properties": {
        "operation": {
          "enum": ["host_status"]
        },
        "ok": {
          "const": true
        },
        "result": {
          "$ref": "#/$defs/host_status"
        }
      }
    },
    {
      "required": ["operation", "ok", "error"],
      "properties": {
        "operation": {
          "enum": ["host_status"]
        },
        "ok": {
          "const": false
        },
        "result": {
          "$ref": "#/$defs/host_status"
        }
      }
    },
    {
      "properties": {
        "ok": {
          "const": false
        }
      },
      "required": ["error"],
      "not": {
        "anyOf": [
          {
            "required": ["operation"]
          },
          {
            "required": ["request_id"]
          },
          {
            "required": ["result"]
          }
        ]
      }
    }
  ],
  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}(?![\\s\\S])"
    },
    "member_name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}(?![\\s\\S])"
    },
    "holder": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}(?![\\s\\S])"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}(?![\\s\\S])"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "oid": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})(?![\\s\\S])"
    },
    "token": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{32}|[a-f0-9]{48})(?![\\s\\S])"
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "maxLength": 35
    },
    "branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "root_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/[^\\u0000]*(?![\\s\\S])"
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1125899906842624
    },
    "inodes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1099511627776
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "phase"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "phase": {
          "enum": ["starting", "running", "stopped"]
        }
      }
    },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["holder", "mode", "stop_requested"],
      "properties": {
        "holder": {
          "$ref": "#/$defs/holder"
        },
        "mode": {
          "enum": ["cooperative", "supervised"]
        },
        "stop_requested": {
          "type": "boolean"
        },
        "execution": {
          "$ref": "#/$defs/execution"
        }
      }
    },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lease_token"],
      "properties": {
        "lease_token": {
          "$ref": "#/$defs/token"
        }
      }
    },
    "vector": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "commit"],
        "properties": {
          "name": {
            "$ref": "#/$defs/member_name"
          },
          "commit": {
            "$ref": "#/$defs/oid"
          }
        }
      }
    },
    "pending": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation_id", "manifest_sha256", "members"],
      "properties": {
        "generation_id": {
          "$ref": "#/$defs/id"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/digest"
        },
        "previous_seal": {
          "$ref": "#/$defs/oid"
        },
        "members": {
          "$ref": "#/$defs/vector"
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation_id", "manifest_sha256", "members", "seal"],
      "properties": {
        "generation_id": {
          "$ref": "#/$defs/id"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/digest"
        },
        "previous_seal": {
          "$ref": "#/$defs/oid"
        },
        "members": {
          "$ref": "#/$defs/vector"
        },
        "seal": {
          "$ref": "#/$defs/oid"
        }
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archived_at", "reap_after", "freeze_digest", "automatic"],
      "properties": {
        "archived_at": {
          "$ref": "#/$defs/time"
        },
        "reap_after": {
          "$ref": "#/$defs/time"
        },
        "freeze_digest": {
          "$ref": "#/$defs/digest"
        },
        "frozen_at": {
          "$ref": "#/$defs/time"
        },
        "reaping_digest": {
          "$ref": "#/$defs/digest"
        },
        "reaped_at": {
          "$ref": "#/$defs/time"
        },
        "automatic": {
          "type": "boolean"
        }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bench_id", "seal", "manifest_sha256"],
      "properties": {
        "bench_id": {
          "$ref": "#/$defs/id"
        },
        "seal": {
          "$ref": "#/$defs/oid"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "bench_id",
        "phase",
        "member_count",
        "checkpoint_repository",
        "ready_for_acquisition",
        "quota_bytes",
        "quota_inodes"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "bench_id": {
          "$ref": "#/$defs/id"
        },
        "phase": {
          "enum": [
            "materializing",
            "initializing",
            "prepared",
            "ready",
            "archived",
            "reaping",
            "reaped"
          ]
        },
        "member_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "checkpoint_repository": {
          "$ref": "#/$defs/member_name"
        },
        "ready_for_acquisition": {
          "type": "boolean"
        },
        "quota_bytes": {
          "$ref": "#/$defs/bytes"
        },
        "quota_inodes": {
          "$ref": "#/$defs/inodes"
        },
        "lease": {
          "$ref": "#/$defs/lease"
        },
        "checkpoint": {
          "$ref": "#/$defs/checkpoint"
        },
        "pending": {
          "$ref": "#/$defs/pending"
        },
        "recovered_from": {
          "$ref": "#/$defs/recovery"
        },
        "archive": {
          "$ref": "#/$defs/archive"
        },
        "transfer_state": {
          "enum": ["relinquishing", "transferred"]
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["transfer_state"]
          },
          "then": {
            "required": ["checkpoint"],
            "properties": {
              "phase": {
                "enum": ["ready", "archived", "reaping", "reaped"]
              },
              "ready_for_acquisition": {
                "const": false
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": ["lease"]
                },
                {
                  "required": ["pending"]
                }
              ]
            }
          }
        },
        {
          "if": {
            "required": ["transfer_state"],
            "properties": {
              "transfer_state": {
                "const": "relinquishing"
              }
            }
          },
          "then": {
            "properties": {
              "phase": {
                "const": "ready"
              }
            }
          }
        }
      ]
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace"],
      "properties": {
        "workspace": {
          "$ref": "#/$defs/workspace"
        },
        "grant": {
          "$ref": "#/$defs/grant"
        },
        "root_path": {
          "$ref": "#/$defs/root_path"
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace"],
      "properties": {
        "workspace": {
          "$ref": "#/$defs/workspace"
        },
        "grant": {
          "$ref": "#/$defs/grant"
        },
        "root_path": {
          "$ref": "#/$defs/root_path"
        },
        "execution": {
          "$ref": "#/$defs/execution"
        },
        "exit_code": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "log_truncated": {
          "type": "boolean"
        }
      }
    },
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace", "preparation"],
      "properties": {
        "workspace": {
          "$ref": "#/$defs/workspace"
        },
        "grant": {
          "$ref": "#/$defs/grant"
        },
        "root_path": {
          "$ref": "#/$defs/root_path"
        },
        "execution": {
          "$ref": "#/$defs/execution"
        },
        "exit_code": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "log_truncated": {
          "type": "boolean"
        },
        "preparation": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "status"],
            "properties": {
              "name": {
                "$ref": "#/$defs/member_name"
              },
              "status": {
                "enum": ["prepared", "failed", "pending"]
              }
            }
          }
        }
      }
    },
    "workspace_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "key",
        "bench_id",
        "phase",
        "member_count",
        "checkpoint_repository",
        "ready_for_acquisition",
        "quota_bytes",
        "quota_inodes",
        "members"
      ],
      "properties": {
        "kind": {
          "const": "workspace"
        },
        "key": {
          "$ref": "#/$defs/key"
        },
        "bench_id": {
          "$ref": "#/$defs/id"
        },
        "phase": {
          "enum": [
            "materializing",
            "initializing",
            "prepared",
            "ready",
            "archived",
            "reaping",
            "reaped"
          ]
        },
        "member_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "checkpoint_repository": {
          "$ref": "#/$defs/member_name"
        },
        "ready_for_acquisition": {
          "type": "boolean"
        },
        "quota_bytes": {
          "$ref": "#/$defs/bytes"
        },
        "quota_inodes": {
          "$ref": "#/$defs/inodes"
        },
        "lease": {
          "$ref": "#/$defs/lease"
        },
        "checkpoint": {
          "$ref": "#/$defs/checkpoint"
        },
        "pending": {
          "$ref": "#/$defs/pending"
        },
        "recovered_from": {
          "$ref": "#/$defs/recovery"
        },
        "archive": {
          "$ref": "#/$defs/archive"
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "branch",
              "base",
              "object_format",
              "source_commit"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/member_name"
              },
              "branch": {
                "$ref": "#/$defs/branch"
              },
              "base": {
                "$ref": "#/$defs/branch"
              },
              "object_format": {
                "enum": ["sha1", "sha256"]
              },
              "source_commit": {
                "$ref": "#/$defs/oid"
              }
            }
          }
        },
        "transfer_state": {
          "enum": ["relinquishing", "transferred"]
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["transfer_state"]
          },
          "then": {
            "required": ["checkpoint"],
            "properties": {
              "phase": {
                "enum": ["ready", "archived", "reaping", "reaped"]
              },
              "ready_for_acquisition": {
                "const": false
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": ["lease"]
                },
                {
                  "required": ["pending"]
                }
              ]
            }
          }
        },
        {
          "if": {
            "required": ["transfer_state"],
            "properties": {
              "transfer_state": {
                "const": "relinquishing"
              }
            }
          },
          "then": {
            "properties": {
              "phase": {
                "const": "ready"
              }
            }
          }
        }
      ]
    },
    "scalar_archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archived_at", "automatic"],
      "properties": {
        "archived_at": {
          "$ref": "#/$defs/time"
        },
        "reap_after": {
          "$ref": "#/$defs/time"
        },
        "freeze_digest": {
          "$ref": "#/$defs/digest"
        },
        "frozen_at": {
          "$ref": "#/$defs/time"
        },
        "reaping_digest": {
          "$ref": "#/$defs/digest"
        },
        "reaped_at": {
          "$ref": "#/$defs/time"
        },
        "automatic": {
          "type": "boolean"
        }
      }
    },
    "scalar_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "key",
        "branch",
        "state",
        "quota_bytes",
        "quota_inodes"
      ],
      "properties": {
        "kind": {
          "const": "scalar"
        },
        "key": {
          "$ref": "#/$defs/key"
        },
        "branch": {
          "$ref": "#/$defs/branch"
        },
        "state": {
          "enum": ["active", "archived", "reaping", "reaped"]
        },
        "quota_bytes": {
          "$ref": "#/$defs/bytes"
        },
        "quota_inodes": {
          "$ref": "#/$defs/inodes"
        },
        "checkpoint": {
          "$ref": "#/$defs/oid"
        },
        "lease": {
          "$ref": "#/$defs/lease"
        },
        "archive": {
          "$ref": "#/$defs/scalar_archive"
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["benches"],
      "properties": {
        "benches": {
          "type": "array",
          "minItems": 0,
          "maxItems": 100000,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/workspace_inventory"
              },
              {
                "$ref": "#/$defs/scalar_inventory"
              }
            ]
          }
        }
      }
    },
    "host_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["managed", "data_free_bytes", "state_free_bytes"],
      "properties": {
        "managed": {
          "type": "boolean"
        },
        "data_free_bytes": {
          "$ref": "#/$defs/count"
        },
        "state_free_bytes": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "enum": [
            "invalid_request",
            "forbidden",
            "not_found",
            "conflict",
            "in_progress",
            "operation_in_doubt",
            "unavailable",
            "operation_failed",
            "capacity_exhausted"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    }
  }
}
