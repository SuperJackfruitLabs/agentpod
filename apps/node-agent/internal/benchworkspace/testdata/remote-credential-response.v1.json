{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/SuperJackfruitLabs/treaty/main/schemas/superbench/remote-credential-response.v1.json",
  "title": "PROPOSED SuperBench remote writer-certificate reply",
  "description": "Reply to /v2/remote/credentials: ok true with a result (HTTP 200), or ok false with an error. HTTP status carries the refusal class: 400 invalid_request, 403 forbidden, 404 not_found, 409 conflict, 503 unavailable. The result carries a signed certificate and never the lease token. Like every other SuperBench reply schema, this one is closed: a new field needs a new version.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "operation", "ok", "result"],
      "properties": {
        "version": {
          "const": "superbench.remote.v1"
        },
        "operation": {
          "const": "writer_certificate"
        },
        "ok": {
          "const": true
        },
        "result": {
          "$ref": "#/$defs/credential"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "operation", "ok", "error"],
      "properties": {
        "version": {
          "const": "superbench.remote.v1"
        },
        "operation": {
          "const": "writer_certificate"
        },
        "ok": {
          "const": false
        },
        "error": {
          "$ref": "#/$defs/error"
        }
      }
    }
  ],
  "$defs": {
    "credential": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "certificate",
        "user",
        "address",
        "host_key",
        "host_key_fingerprint",
        "lease_id",
        "generation",
        "valid_before",
        "working_directory"
      ],
      "properties": {
        "certificate": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(ssh-ed25519|ecdsa-sha2-nistp256)-cert-v01@openssh\\.com "
        },
        "user": {
          "type": "string",
          "minLength": 1,
          "maxLength": 34,
          "pattern": "^b-[a-f0-9]{32}$"
        },
        "address": {
          "type": "string",
          "minLength": 1,
          "pattern": "^([0-9]{1,3}(\\.[0-9]{1,3}){3}|\\[[0-9A-Fa-f:.]+\\]):[0-9]{1,5}$"
        },
        "host_key": {
          "type": "string",
          "minLength": 1
        },
        "host_key_fingerprint": {
          "type": "string",
          "minLength": 1,
          "pattern": "^SHA256:"
        },
        "lease_id": {
          "type": "string",
          "minLength": 32,
          "maxLength": 32,
          "pattern": "^[a-f0-9]{32}$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "valid_before": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
        },
        "working_directory": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/[^\\u0000-\\u001f\\u007f]*$"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "enum": [
            "invalid_request",
            "forbidden",
            "not_found",
            "conflict",
            "unavailable"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
