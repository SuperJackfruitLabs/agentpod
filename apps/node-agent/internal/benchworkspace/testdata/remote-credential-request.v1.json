{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/SuperJackfruitLabs/treaty/main/schemas/superbench/remote-credential-request.v1.json",
  "title": "PROPOSED SuperBench remote writer-certificate request",
  "description": "POST /v2/remote/credentials. Exactly five string fields; unknown, duplicate or missing fields are refused, and the body is at most 16 KiB. The public key is bounded here and accepted or refused by SuperBench's certificate authority. maxLength counts characters; the producer bounds the public key at 8192 bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "operation", "key", "lease_token", "public_key"],
  "properties": {
    "version": {
      "const": "superbench.remote.v1"
    },
    "operation": {
      "const": "writer_certificate"
    },
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "lease_token": {
      "type": "string",
      "minLength": 32,
      "maxLength": 32,
      "pattern": "^[a-f0-9]{32}$"
    },
    "public_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    }
  }
}
