---
/**
 * agentpod.dev.
 *
 * Rewritten 2026-10-21 against the claims ledger (sjl-marketing foundation/products.md,
 * AgentPod section, pinned to v0.1.98) and docs.agentpod.dev. Previous rewrite: 2026-09-12.
 *
 * What changed and why:
 * - "No account here to sign up for — clone it, run it" is gone. Since v0.1.92 the hub
 *   refuses to boot without ORG_PLANE_* settings and a credential from an external account
 *   service that is not public source (ledger AP-03, AP-13). The page now says so.
 * - The harness list is the v0.1.98 registry (`buildRegistry` in
 *   apps/node-agent/cmd/agentpod-node/registry.go): eight, with Muse Code and Kilo. Salaam is
 *   on main only and must not appear until a release carries it. The list is rendered from
 *   `harnesses` below and nowhere else. A descriptor means detection, not parity (AP-02).
 * - "Every action is written to the audit trail before it is dispatched" was dropped: the docs
 *   say it, but the ledger does not carry it, and only ledger claims go on this page.
 * - Provisioning, scan/posture and macOS signing carry their ledger caveats (AP-05, AP-04,
 *   AP-01/#228).
 *
 * The suite frame adds the claims list, "works on its own", the version and the footer, so
 * this page does not.
 */
import Mark from '../components/Mark.astro';

// The release this page describes. Change it, the harness list and the caveats together,
// against the ledger. The install commands use releases/latest, so they do not go stale.
const RELEASE = 'v0.1.98';

// buildRegistry at the RELEASE tag. One list; the page renders it once.
const harnesses = ['Hermes', 'OpenClaw', 'Claude Code', 'Codex', 'OpenCode', 'Pi', 'Muse Code', 'Kilo'];

const SITE = 'https://agentpod.dev';
const DOCS = 'https://docs.agentpod.dev';
const TITLE = 'AgentPod — the console for the machines your agents live on';
const DESCRIPTION =
  'A console for the machines your agents run on. A small Go agent on each machine dials out ' +
  'to your hub, and you work with each agent runtime’s files, logs, terminal and health from one place.';

// Invented data for the hero example. Labelled as an example on the page.
const nodes = [
  {
    name: 'workhorse',
    kind: 'VPS · Ubuntu',
    state: 'online',
    stations: [
      { name: 'hermes', detail: 'support-triage' },
      { name: 'claude-code', detail: 'billing-api' },
    ],
  },
  {
    name: 'mba-priya',
    kind: 'laptop · behind CGNAT',
    state: 'online',
    stations: [{ name: 'codex', detail: 'design-system' }],
  },
  {
    name: 'pod-7f3a',
    kind: 'provisioned · Docker',
    state: 'idle',
    stations: [{ name: 'opencode', detail: 'nightly-sweep' }],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{TITLE}</title>
    <meta name="description" content={DESCRIPTION} />
    <link rel="canonical" href={`${SITE}/`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- What a pasted link unfurls as. Without these, Slack and X showed a bare URL. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AgentPod" />
    <meta property="og:url" content={`${SITE}/`} />
    <meta property="og:title" content={TITLE} />
    <meta property="og:description" content={DESCRIPTION} />
    <meta property="og:image" content={`${SITE}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="AgentPod — the console for the machines your agents live on." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={TITLE} />
    <meta name="twitter:description" content={DESCRIPTION} />
    <meta name="twitter:image" content={`${SITE}/og.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,800&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
    />
    <style>
      :root {
        --ink: #101c2b;
        --raised: #18293c;
        --raised-2: #21374e;
        --line: #2c4560;
        --text: #eef4fa;
        --muted: #93a8bf;
        --cyan: #5fb3d4;
        --green: #63c9a0;
        --display: 'Bricolage Grotesque', 'Trebuchet MS', sans-serif;
        --body: 'IBM Plex Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        --mono: 'IBM Plex Mono', ui-monospace, 'SF Mono', Menlo, monospace;
      }

      /* Light, for a visitor whose system asks for it. The docs site follows the
         reader's preference, so a dark-only page here would mean a dark landing
         page and light docs — the mismatch worth avoiding. */
      @media (prefers-color-scheme: light) {
        :root:not([data-theme="dark"]) {
          --ink: #fbfcfe;
          --raised: #eef3f8;
          --raised-2: #e0e9f2;
          --line: #ccdae7;
          --text: #101c29;
          --muted: #4b6076;
          --cyan: #1d6c8c;
          --green: #1c7a5b;
        }
      }

      /* The same light set, chosen explicitly with the header toggle. */
      :root[data-theme="light"] {
        --ink: #fbfcfe;
        --raised: #eef3f8;
        --raised-2: #e0e9f2;
        --line: #ccdae7;
        --text: #101c29;
        --muted: #4b6076;
        --cyan: #1d6c8c;
        --green: #1c7a5b;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        background: var(--ink);
        color: var(--text);
        font-family: var(--body);
        font-size: 17px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      .wrap { width: 100%; max-width: 1080px; margin: 0 auto; padding: 0 24px; }

      header.mast .wrap {
        display: flex; align-items: center; justify-content: space-between;
        padding-top: 26px; padding-bottom: 26px; gap: 20px;
      }
      /* The name is plain text in the product's capitalisation; the mark carries the
         accent. The same treatment is used by the blog header, the console and the docs. */
      .brand {
        display: inline-flex; align-items: center; gap: 10px;
        font-family: var(--display); font-weight: 800; font-size: 21px;
        letter-spacing: -0.02em; color: var(--text); text-decoration: none;
        --mark-accent: var(--cyan);
      }
      nav { display: flex; gap: 22px; font-size: 15px; }
      nav a { color: var(--muted); text-decoration: none; }
      nav a:hover, nav a:focus-visible { color: var(--text); }
      nav { align-items: center; }
      #theme {
        font: inherit; font-size: 14px; color: var(--muted); background: none;
        border: 1px solid var(--line); border-radius: 7px; padding: 4px 10px; cursor: pointer;
      }
      #theme:hover, #theme:focus-visible { color: var(--text); border-color: var(--cyan); }
      .example-tag {
        margin-left: auto; font-size: 11.5px; letter-spacing: 0.04em; text-transform: uppercase;
        border: 1px solid var(--line); border-radius: 5px; padding: 1px 7px; color: var(--muted);
      }
      ol.steps { list-style: none; margin: 0; padding: 0; counter-reset: step; }
      ol.steps .cell { counter-increment: step; }
      ol.steps .cell::before {
        content: counter(step, decimal-leading-zero); display: block;
        color: var(--cyan); font-family: var(--mono); font-weight: 500; font-size: 13px;
      }
      .cell .chips { margin-top: 12px; }
      .cell .chips li { font-size: 12px; padding: 4px 9px; }
      h3.run { font-family: var(--display); font-size: 1.1rem; font-weight: 600; margin: 34px 0 8px; }
      ul.limits { margin: 0; padding-left: 1.2em; max-width: 680px; }
      ul.limits li { margin: 0 0 12px; }
      ul.limits strong { color: var(--text); }
      section.band p, ul.limits { color: var(--muted); }
      code { font-family: var(--mono); font-size: 0.92em; }

      /* One hero for all six landing pages (operator decision 2026-10-21). */
      .hero-in { max-width: 1080px; margin: 0 auto; padding: 0 24px; }
      .hero-grid {
        display: grid; grid-template-columns: minmax(0, 1fr) 500px; gap: 56px;
        align-items: center; min-height: calc(100svh - 108px); padding-top: 56px; padding-bottom: 72px;
      }
      h1 {
        font-family: var(--display); font-weight: 800;
        font-size: clamp(40px, 4.6vw, 60px); line-height: 1.04;
        letter-spacing: -0.02em; margin: 0; max-width: 12ch;
      }
      h1 em { font-style: normal; color: var(--cyan); }
      .lede {
        font-family: var(--body); font-size: 18px; line-height: 1.55; max-width: 34em;
        margin: 20px 0 28px; color: var(--muted);
      }
      .actions { display: flex; gap: 12px; flex-wrap: wrap; }
      .btn {
        display: inline-flex; align-items: center; height: 46px; padding: 0 20px;
        border-radius: 10px; font: 600 15px var(--body); text-decoration: none;
        border: 1px solid transparent; box-sizing: border-box;
      }
      .btn-primary { background: var(--cyan); color: var(--ink); }
      .btn-primary:hover { filter: brightness(1.1); }
      .btn-ghost { background: transparent; border-color: var(--line); color: var(--text); }
      .btn-ghost:hover { border-color: var(--cyan); }
      .demo { width: 500px; max-width: 100%; }
      .demo-cap { margin-top: 10px; font: 12px var(--mono); color: var(--muted); }

      /* ── the fleet panel: this page's signature ─────────────────── */
      .fleet {
        background: var(--raised); border: 1px solid var(--line);
        border-radius: 15px; overflow: hidden;
      }
      .fleet-head {
        display: flex; align-items: center; gap: 9px; padding: 13px 16px;
        border-bottom: 1px solid var(--line); font-size: 14px; color: var(--muted);
      }
      .fleet-head b { color: var(--text); font-weight: 600; }
      .fleet-body { padding: 6px 0; }
      .node { padding: 11px 16px; border-bottom: 1px solid var(--line); }
      .node:last-child { border-bottom: 0; }
      .node-row { display: flex; align-items: center; gap: 9px; }
      .led { width: 7px; height: 7px; border-radius: 50%; flex: none; }
      .led.online { background: var(--green); }
      .led.idle { background: var(--muted); }
      .node-name { font-weight: 600; font-size: 15px; }
      .node-kind { color: var(--muted); font-size: 13px; margin-left: auto; }
      .stations { margin: 8px 0 0 16px; padding-left: 12px; border-left: 1px solid var(--line); }
      .station { display: flex; gap: 10px; font-size: 13.5px; padding: 3px 0; }
      .station .s-name { font-family: var(--mono); color: var(--cyan); }
      .station .s-detail { color: var(--muted); }
      .fleet-foot {
        border-top: 1px solid var(--line); padding: 11px 16px;
        font-size: 12.5px; color: var(--muted);
      }

      /* ── hero moment: nodes dial in one by one (plays once, see script) ── */
      .led { position: relative; }
      .led::after {
        content: ''; position: absolute; inset: 0; border-radius: 50%;
        border: 1.5px solid var(--green); opacity: 0; pointer-events: none;
      }
      .led.idle::after { border-color: var(--cyan); }
      .demo.playing .node {
        animation: dm-in 380ms cubic-bezier(.2,.7,.3,1) backwards;
        animation-delay: calc(var(--i) * 650ms);
      }
      .demo.playing .led::after {
        animation: dm-ring 620ms ease-out backwards;
        animation-delay: calc(var(--i) * 650ms + 200ms);
      }
      .demo.playing .station {
        animation: dm-slide 320ms cubic-bezier(.2,.7,.3,1) backwards;
        animation-delay: calc(var(--i) * 650ms + 300ms + var(--j) * 120ms);
      }
      @keyframes dm-in { from { opacity: 0; transform: translateY(10px); } }
      @keyframes dm-slide { from { opacity: 0; transform: translateX(-12px); } }
      @keyframes dm-ring {
        0% { opacity: .9; transform: scale(1); }
        100% { opacity: 0; transform: scale(3.2); }
      }

      section.band { border-top: 1px solid var(--line); }
      section.band .wrap { padding-top: 88px; padding-bottom: 88px; }
      section.band p, section.band ul, section.band ol { text-align: left; }
      section.band > .wrap > p { max-width: 680px; }
      h2 {
        font-family: var(--display); font-weight: 600;
        font-size: clamp(28px, 3vw, 36px); line-height: 1.15; letter-spacing: -0.025em;
        margin: 0 0 12px; text-wrap: balance;
      }
      .sub { color: var(--muted); margin: 0 0 32px; max-width: 640px; font-size: 17px; line-height: 1.6; }
      .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }
      .cell h3 {
        font-family: var(--display); font-size: 18px; font-weight: 600;
        margin: 10px 0 6px; letter-spacing: -0.015em;
      }
      .cell p { margin: 0; color: var(--muted); font-size: 15.5px; }

      pre {
        background: var(--raised); border: 1px solid var(--line); border-radius: 10px;
        padding: 15px 17px; overflow-x: auto; margin: 0 0 14px; max-width: 760px;
        font-family: var(--mono); font-size: 13.5px; line-height: 1.65; color: var(--text);
      }
      pre .c { color: var(--muted); }
      .note { color: var(--muted); font-size: 14.5px; margin: 0; max-width: 680px; }

      .chips { display: flex; gap: 9px; flex-wrap: wrap; list-style: none; margin: 0; padding: 0; }
      .chips li {
        font-family: var(--mono); font-size: 13px; color: var(--text);
        border: 1px solid var(--line); border-radius: 7px; padding: 7px 13px;
        background: var(--raised);
      }

      footer { border-top: 1px solid var(--line); }
      footer .wrap {
        display: flex; justify-content: space-between; gap: 20px; flex-wrap: wrap;
        padding-top: 32px; padding-bottom: 44px; font-size: 14.5px; color: var(--muted);
      }
      footer a { color: var(--muted); }
      footer a:hover { color: var(--text); }
      .fnav { display: flex; gap: 20px; flex-wrap: wrap; }

      @media (max-width: 899px) {
        .grid { grid-template-columns: 1fr; gap: 28px; }
        section.band .wrap { padding-top: 64px; padding-bottom: 64px; }
      }
      @media (max-width: 899px) {
        .hero-grid { grid-template-columns: 1fr; gap: 40px; min-height: auto; padding-top: 40px; padding-bottom: 56px; }
        .demo { width: 100%; }
      }
      @media (prefers-reduced-motion: reduce) {
        * { transition: none !important; animation: none !important; }
      }
    </style>
    <script is:inline>
      // Before paint: honour a remembered choice, otherwise follow the system.
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>

  <body>
    <header class="mast">
      <div class="wrap">
        <a class="brand" href="/"><Mark />AgentPod</a>
        <nav>
          <a href={DOCS}>Docs</a>
          <a href="https://github.com/SuperJackfruitLabs/agentpod">Source</a>
          <a href="https://superjackfruit.com">SuperJackfruit Labs</a>
          <button id="theme" type="button" aria-label="Switch light and dark theme">Theme</button>
        </nav>
      </div>
    </header>

    <section class="hero">
      <div class="hero-in hero-grid">
        <div>
          <h1>The console for the machines your agents <em>live on</em>.</h1>
          <p class="lede">
            AgentPod puts a small Go agent on each machine where your agents run. It dials out to
            a hub, and from one console you read each runtime's files, tail its logs, open a
            terminal and check its health.
          </p>
          <div class="actions">
            <a class="btn btn-primary" href={`${DOCS}/use/scan/`}>Get started</a>
            <a class="btn btn-ghost" href={DOCS}>Docs</a>
          </div>
        </div>

        <div class="demo">
        <!-- Signature element: invented data, labelled as an example. -->
        <div class="fleet" role="img"
          aria-label="Example fleet with invented names: three nodes — a VPS, a laptop behind CGNAT, and a provisioned Docker container — each listing the harness stations on it. All are reachable because every node dials out to the hub.">
          <div class="fleet-head">
            <b>Fleet</b><span>3 nodes · 4 stations</span>
          </div>
          <div class="fleet-body">
            {nodes.map((n, i) => (
              <div class="node" style={`--i:${i}`}>
                <div class="node-row">
                  <span class={`led ${n.state}`} aria-hidden="true"></span>
                  <span class="node-name">{n.name}</span>
                  <span class="node-kind">{n.kind}</span>
                </div>
                <div class="stations">
                  {n.stations.map((s, j) => (
                    <div class="station" style={`--j:${j}`}>
                      <span class="s-name">{s.name}</span>
                      <span class="s-detail">{s.detail}</span>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>
          <div class="fleet-foot">
            Every node dials <strong>out</strong>. No inbound ports, which is why the laptop is
            in the fleet on the same terms as the VPS.
          </div>
        </div>
        <p class="demo-cap">Example fleet. Names and machines are invented.</p>
        </div>
      </div>
    </section>

    <section class="band">
      <div class="wrap">
        <h2>How it works</h2>
        <ol class="grid steps">
          <li class="cell">
            <h3>Install <code>apn</code> on a machine</h3>
            <p>One install script on a server, a laptop or a container. The node agent dials out
              to your hub over a WebSocket, so it needs no inbound port and works from behind
              NAT.</p>
          </li>
          <li class="cell">
            <h3>It finds the agents there</h3>
            <p>A descriptor per harness detects what is running and where its config and logs
              live. {RELEASE} has descriptors for:</p>
            <ul class="chips">{harnesses.map((h) => <li>{h}</li>)}</ul>
          </li>
          <li class="cell">
            <h3>You work from the console</h3>
            <p>Adopt a station, then use its panels: files, logs, terminal, health, start and
              stop, cleanup, changesets. A request for a capability the station has not declared
              is refused at the hub.</p>
          </li>
        </ol>
        <p class="note" style="margin-top: 28px;">
          A descriptor means AgentPod can detect that harness. What it can do with each one
          depends on the harness and how the host is set up, so the panels are not the same for
          every harness. AgentPod detects Muse Code and Kilo; their capabilities beyond detection have not been checked.
        </p>
      </div>
    </section>

    <section class="band">
      <div class="wrap">
        <h2>What it's like to use</h2>
        <p class="sub">
          Say you have a Hermes agent on a VPS and Codex on a laptop that sits behind your
          home router. Both machines have dialled out to your hub, so both show up in one fleet.
          The laptop's agent stopped answering: you open its station, tail the log, and open a
          terminal to look around, without forwarding a port. Before you restart it you check
          the changeset to see what it actually changed in its working tree. Then the VPS is
          low on disk: you plan a cleanup, read the plan, and only then apply it.
        </p>
      </div>
    </section>

    <section class="band">
      <div class="wrap">
        <h2>Run it yourself</h2>
        <p class="sub">
          The latest release is {RELEASE}. Its downloads are the node agent (<code>apn</code>)
          and the <code>fleet</code> CLI, for Linux and macOS on amd64 and arm64, with a
          <code>SHA256SUMS</code> file.
        </p>

        <h3 class="run">First: check a machine, no hub needed</h3>
        <p class="sub" style="margin-bottom: 18px;">
          <code>apn scan</code> checks the agent runtimes on a host for the two ways they get
          taken over: a listener bound to every interface, and credential files other users can
          read. It needs no hub, no account and no network, and exits 0, 1 or 2, so it works in
          cron.
        </p>
        <pre><code><span class="c"># the released binary, run where it lands; nothing else is installed</span>
curl -fsSLO https://github.com/SuperJackfruitLabs/agentpod/releases/latest/download/agentpod-node-linux-amd64
curl -fsSLO https://github.com/SuperJackfruitLabs/agentpod/releases/latest/download/SHA256SUMS
sha256sum --ignore-missing -c SHA256SUMS
chmod +x agentpod-node-linux-amd64
./agentpod-node-linux-amd64 scan</code></pre>
        <p class="note">
          Swap the suffix for <code>linux-arm64</code>, <code>darwin-amd64</code> or
          <code>darwin-arm64</code>; on macOS check with
          <code>shasum -a 256 --ignore-missing -c SHA256SUMS</code>. A check that cannot
          determine an answer reports unknown and says why. It is never reported as a pass.
        </p>

        <h3 class="run">Then: enroll a machine with a hub</h3>
        <p class="sub" style="margin-bottom: 18px;">
          Create an enrollment token in the console (single use, valid for an hour), then run
          one command on the host. It downloads the right binary, installs a service and enrolls.
        </p>
        <pre><code>curl -fsSL https://github.com/SuperJackfruitLabs/agentpod/releases/latest/download/install.sh \
  | sudo bash -s -- https://hub.example.com &lt;TOKEN&gt;</code></pre>
        <p class="note">
          Without root, add <code>--user</code> after <code>-s --</code> to install under your
          login session (a systemd user unit on Linux, a LaunchAgent on macOS).
          <code>apn status</code> exits 0 once the service runs and the hub accepts it.
        </p>

        <h3 class="run">The hub</h3>
        <p class="sub" style="margin-bottom: 0;">
          The hub is a Bun service over Postgres and the console is a static site. Neither has a
          release download; they run from source. Since v0.1.92 the hub does not sign anyone in
          itself: it will not start without five <code>ORG_PLANE_*</code> settings and a
          credential from an external account service, and that service is not public source.
          So enrolling needs a hub you already have access to. Standing up your own from the
          README is not a working path for current releases.
        </p>
      </div>
    </section>

    <section class="band">
      <div class="wrap">
        <h2>Where it runs today</h2>
        <ul class="limits">
          <li><strong>One operator per hub.</strong> The hub reads identity from the external
            account service above. It is not a team or multi-tenant product.</li>
          <li><strong>Unsigned macOS nodes.</strong> The macOS node binaries are not signed yet
            (<a href="https://github.com/SuperJackfruitLabs/agentpod/issues/228">#228</a>), so a
            macOS node asks for permissions again after it updates.</li>
          <li><strong>POSIX only for scan and posture.</strong> <code>apn scan</code>, the
            posture banner and changesets are observation: they show you what is wrong and do
            not fix it. There is no Windows build.</li>
          <li><strong>Provisioning is off by default.</strong> The hub can create runtimes on
            Docker, Cloudflare, Modal or Fly, each behind its own flag. Docker is the documented
            path. Cloudflare has not been verified live, Fly only runs the OpenCode and Pi
            images, and Modal destroys sandboxes after 24 hours.</li>
          <li><strong>Harness support varies.</strong> Detection is not parity: see the note
            under How it works.</li>
        </ul>
      </div>
    </section>

    <footer>
      <div class="wrap">
        <span>AgentPod · MIT</span>
        <span class="fnav">
          <a href={DOCS}>Docs</a>
          <a href="https://github.com/SuperJackfruitLabs/agentpod">Source</a>
          <a href="https://superjackfruit.com">SuperJackfruit Labs</a>
        </span>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const btn = document.getElementById('theme');
        if (!btn) return;
        const root = document.documentElement;
        const current = () =>
          root.dataset.theme ||
          (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        btn.addEventListener('click', () => {
          const next = current() === 'light' ? 'dark' : 'light';
          root.dataset.theme = next;
          try { localStorage.setItem('theme', next); } catch (e) {}
        });
      })();
    </script>
    <script is:inline>
      // Hero moment: once, ~600ms after the demo is first in view. Never loops.
      (() => {
        const demo = document.querySelector('.hero .demo');
        if (!demo || !('IntersectionObserver' in window)) return;
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const io = new IntersectionObserver((es) => {
          if (!es.some((e) => e.isIntersecting)) return;
          io.disconnect();
          setTimeout(() => {
            demo.classList.add('playing');
            setTimeout(() => demo.classList.remove('playing'), 3200);
          }, 600);
        });
        io.observe(demo);
      })();
    </script>
  </body>
</html>
