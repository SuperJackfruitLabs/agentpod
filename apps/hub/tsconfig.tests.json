{
  // The same compiler settings as `tsconfig.json`, with `tests/**/*` added.
  //
  // `tsconfig.json` includes only `src/**/*`, so the test suites — a third of
  // this app's TypeScript — were never typechecked. That is how
  // `capabilities: ["health", "config.manage"]`, a real type error against
  // `Capability[]`, sat in six test files across three PRs while every suite
  // stayed green: the compiler was never pointed at them.
  //
  // A SECOND config rather than widening the first, because the first is
  // green and CI holds it there (`bun run typecheck`, a step in the hub job),
  // while this one still has errors the baseline names.
  //
  // `tests/unit/typecheck-baseline.test.ts` runs BOTH: `src` must report
  // nothing, and this config is held per file to
  // `typecheck-known-red-tests.txt`, so its count cannot move in either
  // direction without a deliberate edit to that file.
  "extends": "./tsconfig.json",
  "include": ["src/**/*", "tests/**/*"],
  "exclude": ["node_modules"]
}
