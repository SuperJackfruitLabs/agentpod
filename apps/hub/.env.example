# =============================================================================
# AgentPod hub — LOCAL DEVELOPMENT configuration
# =============================================================================
# Copy to .env. Every value here works out of the box for `bun run dev`.
#
# This file is deliberately NOT the production reference. Provisioner
# credentials, the kaambaan bridge, the cookie/CORS settings and everything
# else a deployed hub needs live in docs/DEPLOYMENT.md, which is the runbook an
# operator actually follows. Two files offering the same variables is how they
# came to disagree — as of 2026-08-14 this one was still offering COOLIFY_*,
# FORGEJO_* and KEYCLOAK_* variables that nothing has read since the pivot, and
# no DATABASE_URL at all despite the root README telling you to fill one in.
#
# `apps/hub/tests/unit/docs-claims.test.ts` now fails if a variable offered
# here is one no code reads.
# =============================================================================

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────────────────
# Postgres WITH pgvector. Migrations apply automatically on boot.
DATABASE_URL=postgres://agentpod:agentpod-dev-password@localhost:5432/agentpod

# ── Auth ─────────────────────────────────────────────────────────────────────
# Better Auth signing secret. config.ts reads it and passes it to betterAuth()
# explicitly. In production it must be >=32 chars AND mix two character classes.
BETTER_AUTH_SECRET=dev-session-secret-change-in-production

# 32 characters exactly (AES-256-GCM for stored credentials).
# Generate with: openssl rand -hex 16
ENCRYPTION_KEY=dev-encryption-key-32-bytes-long!

# A bearer token that authenticates as DEFAULT_USER_ID on every /api/* route —
# a full console-equivalent credential, not a probe token.
API_TOKEN=dev-token-change-in-production

# GitHub OAuth (optional). Callback: http://localhost:3001/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Browser origins and cookies ──────────────────────────────────────────────
# Unset is correct for local dev: the cookie is host-only and not Secure, so it
# works over http://localhost. A TLS deployment needs both — see DEPLOYMENT.md.
# COOKIE_DOMAIN=.example.com
# COOKIE_SECURE=true
#
# ADDS to the built-in allowlist (localhost:5173, console.agentpod.dev,
# app.agentpod.dev). Comma-separated.
# ALLOWED_ORIGINS=https://console.example.com

# ── Provisioning (all substrates OFF by default) ─────────────────────────────
# Docker is the one you want locally. The others (Cloudflare, Modal, Fly) each
# have required companion variables and a boot refusal naming them — configure
# those from docs/DEPLOYMENT.md, not from here.
ENABLE_DOCKER_PROVISIONING=false
DOCKER_NETWORK=agentpod-net
DOCKER_CONTAINER_PREFIX=agentpod
# Which daemon. Unset means /var/run/docker.sock on this machine. DOCKER_HOST
# and a non-default DOCKER_SOCKET are two answers to one question and are
# refused together.
# DOCKER_SOCKET=/var/run/docker.sock
# DOCKER_HOST=tcp://docker-host.internal:2376
# DOCKER_CERT_PATH=/etc/agentpod/docker-certs
# DOCKER_ALLOW_INSECURE_TCP=false
# DOCKER_PORT=2375

# Images built from apps/node-agent/deploy/ (see docs/DEPLOYMENT.md step 3).
NODE_AGENT_IMAGE=agentpod-node:local
NODE_AGENT_OPENCODE_IMAGE=agentpod-node-opencode:local

# Hub URL a provisioned container dials to enrol. Must be reachable FROM the
# container — never 127.0.0.1. Optional for Docker, required for Modal.
PROVISIONING_HUB_URL=

# ── kaambaan bridge ──────────────────────────────────────────────────────────
# OFF unless this is the literal lowercase string "true". Nothing is inferred
# from a token being present. Roster schema: docs/DEPLOYMENT.md#kaambaan-bridge.
# ENABLE_KAAMBAAN_BRIDGE=false
# KAAMBAAN_BASE_URL=https://kaambaan.dev
# KAAMBAAN_BRIDGE_AGENTS=[{"key":"codex-mac","boardId":"brd_...","token":"kbn_...","stationId":"station_...","hubUserId":"...","mode":"full-auto"}]

# ── Domain / data paths ──────────────────────────────────────────────────────
BASE_DOMAIN=localhost
DOMAIN_PROTOCOL=http
DATA_DIR=./data
REPOS_DIR=./data/repos
VOLUMES_DIR=./data/volumes
# Host path prefix for bind mounts when the hub itself runs inside Docker.
HOST_PATH_PREFIX=

# Public URL containers call back on.
MANAGEMENT_API_PUBLIC_URL=http://localhost:3001

# The user id an API_TOKEN request authenticates as.
DEFAULT_USER_ID=default-user

# ── Not part of the fleet console ────────────────────────────────────────────
# Read by config.ts, consumed by nothing. Kept because the code still reads
# them; turn MetaMCP off and leave the rest alone.
METAMCP_ENABLED=false
